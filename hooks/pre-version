#!/bin/bash
set -euo pipefail

NEW_VERSION="$1"

if ! grep -q '^## \[Next\]$' CHANGELOG.md; then
    echo "CHANGELOG.md has no ## [Next] section" >&2
    exit 1
fi

sed -i "s/^## \[Next\]\$/&\n\n## [${NEW_VERSION}] - $(date +%F)/" CHANGELOG.md

SEMVER='[0-9]\+\.[0-9]\+\.[0-9]\+'

BANNER_FILES=(
    templates/header.tmpl
    generate/testdata/db.gen.go
    generate/testdata/goldens/*/db/db.gen.go
)

sed -i "s/const Version = \"v${SEMVER}\"/const Version = \"v${NEW_VERSION}\"/g" cmd/starfieldctl/main.go

for FILE in "${BANNER_FILES[@]}"; do
    sed -i "s/starfield\tv${SEMVER}/starfield\tv${NEW_VERSION}/g" "$FILE"
done

git add cmd/starfieldctl/main.go "${BANNER_FILES[@]}" CHANGELOG.md
if git diff --cached --quiet; then
    echo "Nothing to commit (files already committed)."
else
    git commit -m "Release v${NEW_VERSION}"
fi
